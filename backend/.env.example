# Comma-separated list of allowed CORS origins. "*" allows any origin.
# For production, set this to your deployed frontend origin, e.g.
# CORS_ORIGINS=https://seasonal-fruits.vercel.app
CORS_ORIGINS=*

# Path to the produce data file. Defaults to the bundled data/seasonal_produce.json.
# DATA_FILE=./data/seasonal_produce.json

# Base path/URL for produce images in API responses. Defaults to "/produce", which the
# frontend serves same-origin from its public/produce/ directory (images are bundled,
# not fetched from the web). Override only if you host the images elsewhere.
# IMAGE_BASE_URL=/produce

# Port the server listens on when run via `python -m app.main`.
PORT=8000
